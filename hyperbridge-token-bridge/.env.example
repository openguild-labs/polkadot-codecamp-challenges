# Deployment Configuration for Hyperbridge TokenBridge
# Copy this file to .env and fill in your values

# Your wallet private key (without 0x prefix)
PRIVATE_KEY=your_private_key_here

# RPC URL for Optimism Sepolia
RPC_URL=https://sepolia.optimism.io

# ============================================
# Hyperbridge Gargantua V3 (Paseo) Addresses
# These are pre-configured, no need to change
# ============================================

# TokenGateway contract address on Optimism Sepolia
TOKEN_GATEWAY=0xFcDa26cA021d5535C3059547390E6cCd8De7acA6

# Fee token (USD.h) address
FEE_TOKEN=0xA801da100bF16D07F668F4A49E1f71fc54D05177

# Token Faucet - get test USD.h tokens here
TOKEN_FAUCET=0x1794aB22388303ce9Cb798bE966eeEBeFe59C3a3

# Etherscan API key for verification (optional)
ETHERSCAN_API_KEY=your_etherscan_api_key
